        "data-designer-speech==0.2.0"
      ]
    },
    "image": {
      "name": "dd-client-0.9",
      "path": null
    }
  },
  "deployments": [
    {
      "model": "example/generator",
      "model_alias": "generator",
      "resources": {
        "nodes": 2
      },
      "served_model_name": null,
      "server": {
        "distributed_init_timeout": "10m",
        "enable_expert_parallel": false,
        "environment": {
          "HF_TOKEN": {
            "environment": "HF_TOKEN",
            "type": "secret"
          }
        },
