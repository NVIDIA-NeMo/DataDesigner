{
  "array_tasks": {
    "count": 2,
    "max_concurrent": 2
  },
  "builder": {
    "inline": {
      "data_designer": {
        "columns": [],
        "model_configs": [
          {
            "alias": "generator",
            "model": "example/generator",
            "provider": "openai"
          },
          {
            "alias": "judge",
            "model": "/models/judge",
            "provider": "openai"
          }
        ]
      }
    },
    "source": null
  },
  "client": {
    "cpus": 32,
    "dependencies": {
      "index_credentials": {
        "private-index": {
          "environment": "PACKAGE_INDEX_TOKEN",
          "type": "secret"
        }
      },
      "lock_file": null,
